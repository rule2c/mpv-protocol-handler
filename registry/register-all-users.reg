Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\mpv]
@="URL:mpv Protocol"
"URL Protocol"=""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\mpv\shell]

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\mpv\shell\open]

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\mpv\shell\open\command]
@="\"C:\\Program Files\\mpv.net\\mpv-protocol-handler.exe\" \"%1\""
